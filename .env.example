# ==============================================================================
# DEPLOYMENT PREPARATION: Environment Variables Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit actual secret keys or production passwords to version control.

# Project Identity
PROJECT_NAME="Deep Learning-Based Cyber Threat Detection and Automated Incident Response"
DEPLOYMENT_PLATFORM=[DEPLOYMENT_PLATFORM]
API_BASE_URL=[API_BASE_URL]

# Server Configuration
HOST=0.0.0.0
PORT=5050
FLASK_DEBUG=False
FLASK_SECRET_KEY=[FLASK_SECRET_KEY_PLACEHOLDER]
MAX_UPLOAD_SIZE_MB=100

# Security Operations & Persistence
RESPONSE_MODE=SIMULATION_ONLY
DATABASE_PATH=data/cyber_soc.db

# Machine Learning Isolation
KERAS_HOME=/app/.keras
MPLCONFIGDIR=/app/.matplotlib_cache

# FreeLLMAPI Gateway Configuration (AI Incident Intelligence Copilot)
FREELLMAPI_BASE_URL=http://localhost:8000/v1
FREELLMAPI_API_KEY=sk-freellmapi-free
FREELLMAPI_MODEL=gemini-1.5-flash
FREELLMAPI_TIMEOUT_SEC=10
