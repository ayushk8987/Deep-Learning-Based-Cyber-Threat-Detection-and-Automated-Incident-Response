# DEPLOYMENT PREPARATION: Git ignore rules

# Virtual Environment
venv/
env/
ENV/
.venv/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Isolated cache directories
.keras/
.matplotlib_cache/
.pytest_cache/

# Environment files with secrets
.env
.env.local

# Operating System files
.DS_Store
Thumbs.db

# Log files
*.log

# Sensitive runtime database (optional - keep tracking template or backup)
*.sqlite3-journal
